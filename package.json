    "@capacitor/core": "^8.0.1",
    "@capgo/native-purchases": "^8.6.5",
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.91.0",
    "clsx": "^2.1.1",
    "google-auth-library": "^10.5.0",
    "googleapis": "^144.0.0",
    "next": "14.2.33",
    "react": "^18",
    "react-dom": "^18",
    "stripe": "^20.3.0",
    "tailwind-merge": "^3.4.0",
    "zustand": "^4.5.7"
  },
  "devDependencies": {
    "@capacitor/android": "^8.0.1",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/ios": "^8.5.0",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "eslint": "^8",
    "eslint-config-next": "14.2.33",
    "exceljs": "^4.4.0",
    "next-sitemap": "^4.2.3",
    "postcss": "^8",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.1",
    "ts-node": "^10.9.2",
    "typescript": "^5"
  }
