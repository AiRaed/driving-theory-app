    "analyze:dvsa": "node tools/analyze-dvsa-workbook.js",
    "transform:dvsa": "ts-node --compiler-options \"{\\\"module\\\":\\\"commonjs\\\"}\" tools/transform-dvsa-bank.ts",
    "test:dvsa": "ts-node --compiler-options \"{\\\"module\\\":\\\"commonjs\\\"}\" lib/questions/dvsaV2.test.ts",
    "test:v2-gate": "ts-node --compiler-options \"{\\\"module\\\":\\\"commonjs\\\"}\" lib/questions/v2PublishGate.test.ts",
    "test:learning-cards": "ts-node --compiler-options \"{\\\"module\\\":\\\"commonjs\\\"}\" lib/learning-cards/phase5a.test.ts && ts-node --compiler-options \"{\\\"module\\\":\\\"commonjs\\\"}\" lib/learning-cards/phase5b.test.ts && ts-node --compiler-options \"{\\\"module\\\":\\\"commonjs\\\"}\" lib/learning-cards/phase5c.test.ts",
    "test:content-production": "ts-node --compiler-options \"{\\\"module\\\":\\\"commonjs\\\"}\" lib/content-production/phase5d.test.ts",
    "import:learning-cards:dry-run": "ts-node --compiler-options \"{\\\"module\\\":\\\"commonjs\\\"}\" tools/import-learning-cards-to-supabase.ts --dry-run",
    "import:learning-cards:apply": "ts-node --compiler-options \"{\\\"module\\\":\\\"commonjs\\\"}\" tools/import-learning-cards-to-supabase.ts --apply --confirm-shared-supabase",
    "classify:explanations": "ts-node --compiler-options \"{\\\"module\\\":\\\"commonjs\\\"}\" tools/classify-explanation-recommendations.ts",
    "seed:learning-cards:drafts": "ts-node --compiler-options \"{\\\"module\\\":\\\"commonjs\\\"}\" tools/seed-learning-card-drafts.ts",
    "test:dvsa-import": "ts-node --compiler-options \"{\\\"module\\\":\\\"commonjs\\\"}\" lib/questions/dvsaV2Import.test.ts",
    "import:dvsa-v2:dry-run": "ts-node --compiler-options \"{\\\"module\\\":\\\"commonjs\\\"}\" tools/import-dvsa-v2-to-supabase.ts",
    "prepare:dvsa-v2:phase-4a": "ts-node --compiler-options \"{\\\"module\\\":\\\"commonjs\\\"}\" tools/phase-4a-safety-prepare.ts",
    "apply:dvsa-v2:migration-0008": "ts-node --compiler-options \"{\\\"module\\\":\\\"commonjs\\\"}\" tools/apply-migration-0008.ts",
    "upload:dvsa-v2:media": "ts-node --compiler-options \"{\\\"module\\\":\\\"commonjs\\\"}\" tools/upload-dvsa-v2-media.ts --confirm-shared-supabase",
    "cutover:dvsa-v2": "ts-node --compiler-options \"{\\\"module\\\":\\\"commonjs\\\"}\" tools/cutover-dvsa-v2.ts --confirm-shared-supabase --i-understand-archive-v1",
    "review:dvsa-media": "node tools/dvsa-media-review/server.mjs"
  },
  "dependencies": {
    "@apple/app-store-server-library": "^3.1.0",
