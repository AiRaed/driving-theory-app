{
  "name": "driving-theory-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "postbuild": "next-sitemap",
    "start": "next start -p $PORT",
    "lint": "next lint",
    "test:entitlement": "ts-node --compiler-options \"{\\\"module\\\":\\\"commonjs\\\"}\" lib/access/entitlement.test.ts && ts-node --compiler-options \"{\\\"module\\\":\\\"commonjs\\\"}\" lib/account/clientAccountStorage.test.ts",
    "test:maintenance": "ts-node --compiler-options \"{\\\"module\\\":\\\"commonjs\\\"}\" lib/maintenance/contentMaintenance.test.ts",
    "import:questions": "ts-node --compiler-options \"{\\\"module\\\":\\\"commonjs\\\"}\" tools/import-questions-to-supabase.ts",
    "verify:questions": "ts-node --compiler-options \"{\\\"module\\\":\\\"commonjs\\\"}\" tools/verify-question-bank.ts",
    "export:questions": "ts-node tools/export-questions.ts",
    "dedupe:questions": "node tools/dedupe.js questions.export.json",
    "dedupe:all": "npm run export:questions && npm run dedupe:questions",
    "generate:pwa-icons": "node tools/generate-pwa-icons.js",
    "generate:vocab-hints": "node tools/generate-vocab-hints.js",
